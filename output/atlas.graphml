ta><data key="page">638</data><data key="evidence">[{"doc": "rigveda", "page": 638, "quote": "HYMN XXXIII. Various Deities."}]</data></node><node id="rv-10-34"><data key="title">RV 10.34 · The gambler’s lament</data><data key="type">hymn</data><data key="summary">A gambler describes the compelling dice, family estrangement and debt, and is advised to turn to agriculture.</data><data key="doc">rigveda</data><data key="page">638</data><data key="evidence">[{"doc": "rigveda", "page": 638, "quote": "HYMN XXXIV. Dice, Etc."}, {"doc": "rigveda", "page": 639, "quote": "For the die's sake, whose single point is final, mine own devoted wife I\nalienated."}]</data></node><node id="rv-10-35"><data key="title">RV 10.35 · Visvedevas</data><data key="type">hymn</data><data key="summary">Hymn heading: Visvedevas. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">640</data><data key="evidence">[{"doc": "rigveda", "page": 640, "quote": "HYMN XXXV. Visvedevas."}]</data></node><node id="rv-10-36"><data key="title">RV 10.36 · Visvedevas</data><data key="type">hymn</data><data key="summary">Hymn heading: Visvedevas. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">641</data><data key="evidence">[{"doc": "rigveda", "page": 641, "quote": "HYMN XXXVI. Visvedevas."}]</data></node><node id="rv-10-37"><data key="title">RV 10.37 · Surya</data><data key="type">hymn</data><data key="summary">Hymn heading: Surya. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">642</data><data key="evidence">[{"doc": "rigveda", "page": 642, "quote": "HYMN XXXVII. Surya."}]</data></node><node id="rv-10-38"><data key="title">RV 10.38 · Indra</data><data key="type">hymn</data><data key="summary">Hymn heading: Indra. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">643</data><data key="evidence">[{"doc": "rigveda", "page"