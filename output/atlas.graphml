"HYMN CXXII. Agni."}]</data></node><node id="rv-10-123"><data key="title">RV 10.123 · Vena</data><data key="type">hymn</data><data key="summary">Hymn heading: Vena. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">721</data><data key="evidence">[{"doc": "rigveda", "page": 721, "quote": "HYMN CXXIII. Vena."}]</data></node><node id="rv-10-124"><data key="title">RV 10.124 · Agni, Etc</data><data key="type">hymn</data><data key="summary">Hymn heading: Agni, Etc. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">721</data><data key="evidence">[{"doc": "rigveda", "page": 721, "quote": "HYMN CXXIV. Agni, Etc."}]</data></node><node id="rv-10-125"><data key="title">RV 10.125 · Vak, the speaking power</data><data key="type">hymn</data><data key="summary">The first-person divine speaker declares her activity among gods and beings, her sovereignty, and her pervasiveness.</data><data key="doc">rigveda</data><data key="page">722</data><data key="evidence">[{"doc": "rigveda", "page": 722, "quote": "HYMN CXXV. Vak."}, {"doc": "rigveda", "page": 722, "quote": "1. I TRAVEL with the Rudras and the Vasus, with the Adityas and All-Gods I"}]</data></node><node id="rv-10-126"><data key="title">RV 10.126 · Visvedevas</data><data key="type">hymn</data><data key="summary">Hymn heading: Visvedevas. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">723</data><data key="evidence">[{"doc": "rigveda", "page": 723, "quote": "HYMN CXXVI. Visvedevas."}]</data></node><node id="rv-10-127"><data key="title">RV 10.127 · Night</data><data key="type">hymn</data><data key="summary">Hymn heading: Night. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">723</data><data key="evidence">[{"doc": "rigveda", "page": 723, "quote": "HYMN CXXVII. Night."}]</data></node><node id="rv-10-128"><data key="title">RV 10.128 · Visvedevas</data><data key="type">hymn</data><data key="summary">Hymn heading: Visvedevas. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">724</data><data key="evidence">[{"doc": "rigveda", "page": 724, "quote": "HYMN CXXVIII. Visvedevas."}]</data></node><node id="rv-10-129"><data key="title">RV 10.129 · Nasadiya, the creation question</data><data key="type">hymn</data><data key="summary">The hymn asks about existence and nonexistence before creation and ends by questioning who knows its origin.</data><data key="doc">rigveda</data><data key="page">724</data><data key="evidence">[{"doc": "rigveda", "page": 724, "quote": "HYMN CXXIX. Creation."}, {"doc": "rigveda", "page": 724, "quote": "1. THEN was not non-existent nor existent: there was no realm of air, no sky"}]</data></node><node id="rv-10-130"><data key="title">RV 10.130 · Creation</data><data key="type">hymn</data><data key="summary">Hymn heading: Creation. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">725</data><data key="evidence">[{"doc": "rigveda", "page": 725, "quote": "HYMN CXXX. Creation."}]</data></node><node id="rv-10-131"><data key="title">RV 10.131 · Indra</data><data key="type">hymn</data><data key="summary">Hymn heading: Indra. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">726</data><data key="evidence">[{"doc": "rigveda", "page": 726, "quote": "HYMN CXXXI. Indra."}]</data></node><node id="rv-10-132"><data key="title">RV 10.132 · Mitra. Varuna</data><data key="type">hymn</data><data key="summary">Hymn heading: Mitra. Varuna. Read the cited passage for the complete hymn.</data><data key="doc">rigveda</data><data key="page">726</data><data key="evidence">[{"doc": "rigveda", "page": 726, "quote": "HYMN CXXXII. Mitra. Varuna."}]</data></node><node id="rv-10-133"><data key="title">RV 10.133 · Indra</data><data key="type">hymn</data><data key="summary">